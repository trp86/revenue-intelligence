# SQL lint for the numbered files under sql/ (spec 10 section 3).
# The rules below are exercised by tests/unit/test_tooling.py.

[sqlfluff]
dialect = duckdb
templater = placeholder
max_line_length = 100

# Named parameters such as $bronze_file are bound by the stage runner (src/revint/pipeline).
# The linter only needs a stand-in value to parse the file; a SQL file that uses a new
# parameter adds a line here.
[sqlfluff:templater:placeholder]
param_style = dollar
bronze_file = 'bronze.parquet'
asof_date = '2020-02-29'
excel_rows = 1
silver_flag_columns = 'f_stray_row'
dormancy_min_orders = 4
dormancy_interval_multiple = 2.0
dormancy_min_days = 45
dormancy_lookback_months = 12
recovery_window_months = 3
recovery_min_decline_pct = 20
recovery_min_prior_sales = 25000
recovery_min_prior_orders = 3
whitespace_min_peer_penetration = 0.5
whitespace_lookback_months = 12
crosssell_min_support = 30
crosssell_min_confidence = 0.3
crosssell_min_lift = 1.2
crosssell_lookback_months = 12
value_low_factor = 0.25
value_high_factor = 0.75
scoring_weight_value = 0.4
scoring_weight_evidence = 0.3
scoring_weight_urgency = 0.2
scoring_weight_data_quality = 0.1
scoring_priority_high = 70
scoring_priority_medium = 40
scoring_confidence_high = 0.7
scoring_confidence_medium = 0.4
scoring_urgency_horizon_days = 365
scoring_urgency_neutral = 0.5

# Code standards: lowercase keywords.
[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = lower

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = lower
